{
  "name": "binance-manager",
  "version": "0.1.0",
  "description": "Desktop app for Binance spot trading: portfolio & P&L, trade journal, orders and automation",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "start": "electron .",
    "build:headless": "node scripts/build-headless.cjs",
    "server": "node out/headless/binance-manager-server.js",
    "build:all": "electron-vite build && node scripts/build-headless.cjs",
    "build:mobile": "vite build -c vite.mobile.config.ts && node scripts/build-headless.cjs --mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "keywords": [],
  "author": "Aymane",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
